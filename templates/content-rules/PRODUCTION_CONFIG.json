{
  "default_language": "vi",
  "default_timezone": "Asia/Ho_Chi_Minh",
  "workflow_mode": "semi_auto",
  "video": {
    "orientation": "VERTICAL",
    "aspect_ratio": "9:16",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "video_codec": "libx264",
    "audio_codec": "aac"
  },
  "voice": {
    "provider": "openai",
    "speed": 1.0,
    "volume": 1.0
  },
  "editing": {
    "minimum_clip_duration_s": 1.5,
    "music_volume": 0.15,
    "subtitle_enabled": true,
    "logo_enabled": true,
    "music_enabled": true
  },
  "review": {
    "require_script": true,
    "require_voice": true,
    "require_footage_for_every_scene": true,
    "require_preview_review": true
  },
  "output": {
    "format": "mp4",
    "file_name_template": "{production_date}_{video_id}_{slug}",
    "upload_to_drive": true
  }
}
