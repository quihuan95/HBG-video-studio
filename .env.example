# Copy this file to .env and fill in your local secrets.
# These OpenAI values can also be edited in Settings inside the Electron app.

# OpenAI — required for footage analysis
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_SCRIPT_MODEL=gpt-6.1-terra
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
# Direct OpenAI model used for video contact-sheet review
OPENAI_REVIEW_MODEL=gpt-6-luna

# Google Drive / Sheets OAuth — values from Google Cloud Console (no JSON files)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match the Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://127.0.0.1:8100/api/oauth/google/callback
# 32 random bytes encoded as 64 hex characters; keep it stable after connecting
TOKEN_ENCRYPTION_KEY=
# Optional: override the default .env path
# APP_ENV_PATH=D:\path\to\.env

# Local backend
API_HOST=127.0.0.1
API_PORT=8100
FLOWKIT_DEBUG_ENDPOINTS=0
FLOW_ENABLED=0
