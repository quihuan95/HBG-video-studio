# Copy this file to .env and fill in your local secrets.

# OpenAI — required for footage analysis
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-6.1-sol

# Google Drive / Sheets — absolute path to a service-account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=D:\secrets\hbg-service-account.json

# Local backend
API_HOST=127.0.0.1
API_PORT=8100
FLOWKIT_DEBUG_ENDPOINTS=0
FLOW_ENABLED=0
