# Copy this file to .env and fill in your local secrets.
# These OpenAI values can also be edited in Settings inside the Electron app.

# OpenAI — required for footage analysis
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_SCRIPT_MODEL=gpt-6.1-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
VBEE_APP_ID=
VBEE_API_TOKEN=
VBEE_TTS_URL=https://api.vbee.vn/v1/tts
VBEE_TIMEOUT_S=120
VBEE_SPEED=1.0
VBEE_BITRATE=128
VBEE_WEBHOOK_URL=http://127.0.0.1:8100/api/vbee/callback
VBEE_POLL_INTERVAL_S=2
VBEE_POLL_TIMEOUT_S=180
CAPCUT_EXPORT_ENABLED=1
CAPCUT_DRAFT_ROOT=C:\Users\Admin\AppData\Local\CapCut\User Data\Projects\com.lveditor.draft
CAPCUT_TEXT_FONT_NAME=Montserrat
CAPCUT_TEXT_FONT_PATH=C:\Windows\Fonts\Montserrat-Regular.ttf
CAPCUT_TEXT_FONT_SIZE=7
CAPCUT_TEXT_X=0
CAPCUT_TEXT_Y=-975
HBG_HOTLINE=(+84) 939.311.911 - (+84) 913.311.911
HBG_TEXT_FONT_PATH=C:\Windows\Fonts\arialbd.ttf
HBG_OUTRO_PATH=
HBG_VIDEO_BITRATE=18M
HBG_VIDEO_MAXRATE=20M

# AI footage search (local/Drive works without an online provider key)
FOOTAGE_SEARCH_ENABLED=1
FOOTAGE_INTERNAL_ENABLED=1
FOOTAGE_EXTERNAL_ENABLED=1
FOOTAGE_SOURCE_PRIORITY=internal_first
FOOTAGE_DEFAULT_ASPECT_RATIO=9:16
FOOTAGE_SEARCH_MAX_RESULTS=5
FOOTAGE_TEMP_DIR=output/footage_research
PEXELS_API_KEY=
# YouTube B-roll via yt-dlp; clips are filtered by rea-video before editing.
# Standard-license YouTube videos are not cleared for reuse; 1 = Creative Commons only.
YOUTUBE_FOOTAGE_ENABLED=1
DRIVE_FOOTAGE_TIMEOUT_S=30
YOUTUBE_CC_ONLY=0
YOUTUBE_MAX_DURATION_S=600
YOUTUBE_MAX_HEIGHT=1080
ONLINE_CLIPS_PER_SCENE=2

# Reference video breakdown (isolated rea-video runtime)
REA_VIDEO_ENABLED=1
REA_VIDEO_CLI=output/_shared/rea-video-runtime/Scripts/rea-video.exe
REA_VIDEO_PINNED_COMMIT=356815c0d61291811551a2b8813b2b571d9b3238
REA_VIDEO_TIMEOUT_S=1800
REA_VIDEO_MAX_INPUT_MB=1000
REA_VIDEO_MAX_DURATION_S=1800
REA_VIDEO_WORKERS=2
REA_VIDEO_ALLOW_VLM=0
REA_VIDEO_ENV_FILE=
# Direct OpenAI model used for video contact-sheet review
OPENAI_REVIEW_MODEL=gpt-6-luna

# Google Drive / Sheets OAuth — values from Google Cloud Console (no JSON files)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match the Authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://127.0.0.1:8100/api/oauth/google/callback
# 32 random bytes encoded as 64 hex characters; keep it stable after connecting
TOKEN_ENCRYPTION_KEY=
# Optional: override the default .env path
# APP_ENV_PATH=D:\path\to\.env

# Local backend
API_HOST=127.0.0.1
API_PORT=8100
FLOWKIT_DEBUG_ENDPOINTS=0
FLOW_ENABLED=0
